{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ajustes.schema.json",
  "title": "ajustes",
  "description": "Cambios de inputs derivados de objeciones validadas por el juez. escenarios.py --ajustes los aplica.",
  "type": "object",
  "required": ["ticker", "fecha_analisis", "ajustes"],
  "properties": {
    "ticker": {"type": "string"},
    "fecha_analisis": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "ajustes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["analista", "driver", "escenario", "valor_anterior", "valor_nuevo", "objecion_ref", "motivo"],
        "properties": {
          "analista": {"enum": ["A", "B", "N", "todos"]},
          "driver": {"type": "string", "minLength": 1},
          "escenario": {"enum": ["bajista", "base", "alcista", "todos"]},
          "valor_anterior": {"oneOf": [{"type": "number"}, {"type": "array", "items": {"type": "number"}}, {"type": "null"}]},
          "valor_nuevo": {"oneOf": [{"type": "number"}, {"type": "array", "items": {"type": "number"}}]},
          "objecion_ref": {"type": "string", "pattern": "^O[0-9]+$"},
          "motivo": {"type": "string", "minLength": 5, "maxLength": 600}
        }
      }
    }
  }
}
