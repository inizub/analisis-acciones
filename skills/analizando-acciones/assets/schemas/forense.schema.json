{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forense.schema.json",
  "title": "forense",
  "description": "Salida del agente forense: banderas cuantitativas (de forense.py) y cualitativas, clasificadas por nivel.",
  "type": "object",
  "required": ["ticker", "fecha_analisis", "banderas"],
  "properties": {
    "ticker": {"type": "string"},
    "fecha_analisis": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "banderas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bandera", "nivel", "origen", "dato_ref"],
        "properties": {
          "bandera": {"type": "string", "minLength": 5, "maxLength": 300},
          "nivel": {"enum": ["informativa", "grave", "invalidante"]},
          "origen": {"enum": ["cuantitativa", "cualitativa"]},
          "dato_ref": {"type": "string", "minLength": 1},
          "metrica": {"type": "string"},
          "justificacion": {"type": "string", "maxLength": 500}
        }
      }
    },
    "resumen": {"type": "string", "maxLength": 800}
  }
}
